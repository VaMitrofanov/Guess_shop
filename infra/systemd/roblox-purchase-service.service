[Unit]
Description=RobloxBank browser purchase service
After=network-online.target xvfb.service
Wants=network-online.target
Requires=xvfb.service

[Service]
Type=simple
User=rbuy
Group=rbuy
WorkingDirectory=/opt/roblox-buyout
EnvironmentFile=/opt/roblox-buyout/purchase-service.env
ExecStart=/usr/bin/node /opt/roblox-buyout/browser-purchase-service.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
