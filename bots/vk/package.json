{
  "name": "robloxbank-vk-bot",
  "version": "1.0.0",
  "private": true,
  "description": "VK community bot \u2014 long-polling consumer for the RobloxBank shop. Deployed as an independent Docker service in Coolify.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tsx bot.ts",
    "dev": "tsx watch bot.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:generate:docker": "prisma generate --schema ./prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.3.1",
    "pg": "^8.12.0",
    "vk-io": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "uuid@8.3.2": "11.1.1"
  }
}
