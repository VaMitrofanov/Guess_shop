# ────────────────────────────────────────────────────────────────────────────
# Site (Next.js storefront) — production env vars for Coolify.
# Each Coolify service sets these independently; only DATABASE_URL is shared
# verbatim across site + bots.
# ────────────────────────────────────────────────────────────────────────────

# --- Database (Neon Postgres) ---
# Use the POOLED endpoint (-pooler suffix) for the storefront — many short-
# lived requests, low concurrent connections per request. Append
# ?pgbouncer=true&connection_limit=1 for serverless-style invocations.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=verify-full&pgbouncer=true

# --- NextAuth ---
NEXTAUTH_URL=https://robloxbank.ru
NEXTAUTH_SECRET=replace-with-`openssl rand -base64 32`

# --- Public client-side ---
NEXT_PUBLIC_APP_URL=https://robloxbank.ru
NEXT_PUBLIC_VK_APP_ID=

# --- Admin / internal ---
ADMIN_SECRET=replace-with-`openssl rand -hex 32`

# --- One-time seed bootstrap (leave both empty in normal production runtime) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_CONTENT=

# --- T-Bank acquiring (both the master flag and an explicit rollout mode are required) ---
SITE_ACQUIRING_ENABLED=false
SITE_ACQUIRING_MODE=off
SITE_ACQUIRING_ALLOWLIST_USER_IDS=
SITE_ACQUIRING_ROLLOUT_PERCENT=0
TINKOFF_TERMINAL_KEY=
TINKOFF_SECRET_KEY=
TINKOFF_TAXATION=
TINKOFF_ITEM_TAX=
TINKOFF_PAYMENT_METHOD=
TINKOFF_PAYMENT_OBJECT=

# --- Bot → Web payment orchestration (same secret on Web, TG and VK) ---
BOT_PAYMENT_API_SECRET=replace-with-`openssl rand -hex 32`
# Personal transfer details live only in runtime env/HANDOFF, never in source/docs.
MANUAL_TRANSFER_BANK=
MANUAL_TRANSFER_RECIPIENT=
MANUAL_TRANSFER_PHONE=
MANUAL_TRANSFER_CONFIG_VERSION=

# --- Telegram outgoing notifications (server-side fetch, no Telegraf SDK) ---
TG_TOKEN=
TG_CHAT_ID=
# Единственный список админов: Telegram ID через запятую. Используется ботами,
# TWA и веб-админкой — роль выводится из него на каждом запросе, поэтому
# снятие ID действует сразу после рестарта, без правок в БД.
ADMIN_IDS=
WORKER_WATCHDOG_ENABLED=false
VK_WORKER_WATCHDOG_ENABLED=true
# VK-watchdog использует Web как независимый email fallback, если Telegram/bridge
# не подтвердил доставку. URL берётся из WEB_BASE_URL/NEXT_PUBLIC_APP_URL.
# Запасной вход владельца, если Telegram недоступен: адреса через запятую.
# Работает только вместе с role=ADMIN у той же записи в БД — нужны оба условия.
ADMIN_BREAKGLASS_EMAILS=

# --- Boss Robux API (purchase gamepasses via bossrobux.com) ---
BOSSROBUX_TOKEN=

# --- SG browser purchase-service (server-side only; Web and TG use different private URLs) ---
ROBLOX_PURCHASE_SERVICE_URL=
ROBLOX_PURCHASE_SERVICE_TOKEN=replace-with-`openssl rand -hex 32`

# --- Google Sheets sync for B2B partner buyouts ---
ANTON_GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# --- Wildberries API token (needed for TWA dashboard WB data) ---
WB_API_TOKEN=

# --- Вход в TWA-админку (ultra-review U1) ---
# Секрет подписи токена запуска в web_app-ссылке бота. Нужен И Web, И TG-боту:
# значения обязаны совпадать. Без него запасной вход отключён целиком, и TWA
# открывается только там, где Telegram отдаёт initData.
TWA_LINK_SECRET=replace-with-`openssl rand -hex 32`

# --- Доверие прокси-заголовкам при определении client IP (ultra-review U2) ---
# direct     — доверяем только hop'у, который дописал наш Traefik (по умолчанию);
# cloudflare — принимаем cf-connecting-ip, но только от диапазонов Cloudflare.
TRUSTED_PROXY_MODE=direct
# CLOUDFLARE_IP_RANGES=  # опционально: переопределить список CIDR

# --- Build-time only (never read at runtime) ---
NODE_ENV=production
